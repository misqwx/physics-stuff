import numpy as np
import matplotlib.pyplot as plt
from matplotlib.widgets import Slider


# Physical constant
G = 9.8  # gravitational acceleration (m/s^2)


def step(theta, omega, dt, L, m, k):
    """Calculate one Euler integration step."""

    angular_acceleration = (
        -G / L * np.sin(theta)
        - k * omega / m
    )

    omega += angular_acceleration * dt
    theta += omega * dt

    return theta, omega


def simulate_pendulum(
    L,
    theta0,
    m=1.0,
    k=0.0,
    dt=0.1,
    t_max=10.0
):
    """Simulate a damped pendulum using Euler's method."""

    theta = theta0
    omega = 0.0
    t = 0.0

    time = []
    angles = []
    angular_velocities = []

    while t < t_max:
        theta, omega = step(theta, omega, dt, L, m, k)
        t += dt

        time.append(t)
        angles.append(theta)
        angular_velocities.append(omega)

    return time, angles, angular_velocities


# --------------------------------------------------
# Initial simulation
# --------------------------------------------------

time, angles, angular_velocities = simulate_pendulum(
    L=1.0,
    theta0=np.pi / 4,
    m=1.0,
    k=0.1
)


# --------------------------------------------------
# Figure
# --------------------------------------------------

fig, (ax1, ax2) = plt.subplots(1, 2)

# Leave space for sliders
plt.subplots_adjust(bottom=0.35)


# Angle vs time
line1, = ax1.plot(time, angles)

ax1.set_xlabel("Time (s)")
ax1.set_ylabel("Angle (rad)")
ax1.set_title("Angle vs Time")


# Phase-space plot
line2, = ax2.plot(angles, angular_velocities)

ax2.set_xlabel("Angle (rad)")
ax2.set_ylabel("Angular Velocity (rad/s)")
ax2.set_title("Angular Velocity vs Angle")


# --------------------------------------------------
# Sliders
# --------------------------------------------------

ax_L = plt.axes([0.2, 0.20, 0.6, 0.03])
ax_theta = plt.axes([0.2, 0.15, 0.6, 0.03])
ax_m = plt.axes([0.2, 0.10, 0.6, 0.03])
ax_k = plt.axes([0.2, 0.05, 0.6, 0.03])


slider_L = Slider(
    ax_L,
    "L (m)",
    0.1,
    3.0,
    valinit=1.0
)

slider_theta = Slider(
    ax_theta,
    "θ₀ (rad)",
    0.0,
    np.pi,
    valinit=np.pi / 4
)

slider_m = Slider(
    ax_m,
    "m (kg)",
    0.1,
    10.0,
    valinit=1.0
)

slider_k = Slider(
    ax_k,
    "k (N·s/m)",
    0.0,
    10.0,
    valinit=0.1
)


# --------------------------------------------------
# Update plots
# --------------------------------------------------

def update(_):
    """Recalculate the simulation when a slider changes."""

    L = slider_L.val
    theta0 = slider_theta.val
    m = slider_m.val
    k = slider_k.val

    time, angles, angular_velocities = simulate_pendulum(
        L=L,
        theta0=theta0,
        m=m,
        k=k
    )

    line1.set_data(time, angles)
    line2.set_data(angles, angular_velocities)

    ax1.relim()
    ax1.autoscale_view()

    ax2.relim()
    ax2.autoscale_view()

    fig.canvas.draw_idle()


# Connect sliders
slider_L.on_changed(update)
slider_theta.on_changed(update)
slider_m.on_changed(update)
slider_k.on_changed(update)


# --------------------------------------------------
# Run
# --------------------------------------------------

plt.show()
