import scipy
from scipy.integrate import solve_ivp
from scipy.optimize import minimize
from scipy.integrate import quad
import numpy as np
import matplotlib.pyplot as plt
from matplotlib.widgets import Slider

def step(theta, omega, dt, L, g, k, m):
    omega = omega + (-g/L * np.sin(theta) - k * omega/m) * dt
    theta = theta + omega * dt
    return theta, omega


def simulate_pendulum(L, theta0, dt=0.1, t_max=10.0, m=1.0, k=0.0):
    g = 9.8
    t = 0.0
    theta = theta0
    omega = 0.0
    time=[]
    angle=[]
    omega_list =[]

    while t < t_max:
        theta, omega = step(theta, omega, dt, L, g, k, m)
        t += dt
        time.append(t)
        angle.append(theta)
        omega_list.append(omega)

    return time, angle, omega_list





fig, (ax1, ax2) = plt.subplots(1, 2)
plt.subplots_adjust(bottom=0.35)

time, angle, omega_list = simulate_pendulum(1.0, np.pi/4)
line1, = ax1.plot(time, angle)
line2, = ax2.plot(angle, omega_list)


ax_L     = plt.axes([0.2, 0.20, 0.6, 0.03])
ax_theta = plt.axes([0.2, 0.15, 0.6, 0.03])
ax_m = plt.axes([0.2, 0.10, 0.6, 0.03])
ax_k = plt.axes([0.2, 0.05, 0.6, 0.03])

slider_L     = Slider(ax_L,     "L",         0.1, 3.0, valinit=1.0)
slider_theta = Slider(ax_theta, "θ₀ (rad)",  0.0, np.pi, valinit=np.pi/4)
slider_m     = Slider(ax_m,     "m (kg)",    0.1, 10.0, valinit=1.0)
slider_k     = Slider(ax_k,     "k (N*s/m)", 0.1, 10.0, valinit=0.1)

def update(val):

    L = slider_L.val
    theta0 = slider_theta.val
    m = slider_m.val
    k = slider_k.val
    time, angle, omega_list = simulate_pendulum(L, theta0, m=m, k=k)

    line1.set_xdata(time)
    line1.set_ydata(angle)
    line2.set_xdata(angle)
    line2.set_ydata(omega_list)

    ax1.relim()
    ax1.autoscale_view()
    ax2.relim()
    ax2.autoscale_view()

    fig.canvas.draw_idle()


slider_L.on_changed(update)
slider_theta.on_changed(update)
slider_m.on_changed(update)
slider_k.on_changed(update)
ax1.set_xlabel("Time (s)")
ax1.set_ylabel("Angle (rad)")
ax2.set_xlabel("Angle (rad)")
ax2.set_ylabel("Angular Velocity (rad/s)")
ax1.set_title("Angle vs Time")
ax2.set_title("Angular Velocity vs Angle")

plt.show()
